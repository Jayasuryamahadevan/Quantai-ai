# QuantAI — .gitignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.pyc
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.ruff_cache/

# Virtual environments
venv/
.venv/
env/
ENV/
.env.local
.env.*.local

# Secrets — NEVER commit these
.env

# Data directories (can be large; generated at runtime)
data/uploads/*
data/exports/*
data/embeddings/*
data/dictionaries/*
!data/uploads/.gitkeep
!data/exports/.gitkeep
!data/embeddings/.gitkeep
!data/dictionaries/.gitkeep

# Frontend
frontend/node_modules/
frontend/dist/
frontend/.vite/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Test artifacts
.pytest_cache/
.coverage
htmlcov/
.tox/

# Docker
*.pid
